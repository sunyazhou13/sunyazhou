</pre></td> --><td class="rouge-code"><pre><span class="nb">source</span> <span class="s2">"https://rubygems.org"</span>

gem <span class="s2">"jekyll"</span>, <span class="s2">"&gt;=3.8.6"</span>

<span class="c"># Official Plugins</span>
