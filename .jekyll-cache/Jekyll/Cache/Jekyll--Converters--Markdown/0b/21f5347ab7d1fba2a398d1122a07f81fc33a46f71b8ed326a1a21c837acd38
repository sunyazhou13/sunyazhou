            <span class="c1">/// 3. Notify Observers: RunLoop is about to trigger Source0 (non-port) callbacks.</span>
            <span class="n">__CFRunLoopDoObservers</span><span class="p">(</span><span class="n">runloop</span><span class="p">,</span> <span class="n">currentMode</span><span class="p">,</span> <span class="n">kCFRunLoopBeforeSources</span><span class="p">);</span>
