</pre></td> --><td class="rouge-code"><pre><span class="n">mach_msg_return_t</span> <span class="nf">mach_msg</span><span class="p">(</span>
			<span class="n">mach_msg_header_t</span> <span class="o">*</span><span class="n">msg</span><span class="p">,</span>
			<span class="n">mach_msg_option_t</span> <span class="n">option</span><span class="p">,</span>
