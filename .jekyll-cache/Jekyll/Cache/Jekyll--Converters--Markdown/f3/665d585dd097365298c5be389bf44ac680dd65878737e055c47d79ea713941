        <span class="k">return</span> <span class="n">allCases</span><span class="o">.</span><span class="nf">randomElement</span><span class="p">(</span><span class="nv">using</span><span class="p">:</span> <span class="o">&amp;</span><span class="n">generator</span><span class="p">)</span><span class="o">!</span>
    <span class="p">}</span>
<span class="p">}</span>

