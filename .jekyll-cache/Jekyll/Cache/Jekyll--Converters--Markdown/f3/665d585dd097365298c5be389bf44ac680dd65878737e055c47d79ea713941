17
18
19
20
21
</pre></td><td class="rouge-code"><pre><span class="kd">enum</span> <span class="kt">Suit</span><span class="p">:</span> <span class="kt">String</span><span class="p">,</span> <span class="kt">CaseIterable</span> <span class="p">{</span>
    <span class="k">case</span> <span class="n">diamonds</span> <span class="o">=</span> <span class="s">"♦"</span>
    <span class="k">case</span> <span class="n">clubs</span> <span class="o">=</span> <span class="s">"♣"</span>
    <span class="k">case</span> <span class="n">hearts</span> <span class="o">=</span> <span class="s">"♥"</span>
    <span class="k">case</span> <span class="n">spades</span> <span class="o">=</span> <span class="s">"♠"</span>
    
    <span class="kd">static</span> <span class="kd">func</span> <span class="nf">random</span><span class="p">()</span> <span class="o">-&gt;</span> <span class="kt">Suit</span> <span class="p">{</span>
        <span class="k">return</span> <span class="kt">Suit</span><span class="o">.</span><span class="nf">random</span><span class="p">(</span><span class="nv">using</span><span class="p">:</span> <span class="o">&amp;</span><span class="kt">Random</span><span class="o">.</span><span class="k">default</span><span class="p">)</span>
    <span class="p">}</span>
    
    <span class="kd">static</span> <span class="kd">func</span> <span class="n">random</span><span class="o">&lt;</span><span class="kt">T</span><span class="p">:</span> <span class="kt">RandomNumberGenerator</span><span class="o">&gt;</span>
        <span class="p">(</span><span class="n">using</span> <span class="nv">generator</span><span class="p">:</span> <span class="k">inout</span> <span class="kt">T</span><span class="p">)</span> <span class="o">-&gt;</span> <span class="kt">Suit</span>
    <span class="p">{</span>
        <span class="c1">// Force-unwrap can't fail as long as the</span>
