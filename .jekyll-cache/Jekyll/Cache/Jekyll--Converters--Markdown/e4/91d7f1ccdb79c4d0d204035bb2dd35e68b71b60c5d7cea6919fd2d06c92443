            <span class="p">}</span> <span class="nv">symbols</span><span class="p">:</span> <span class="p">{</span>
                <span class="kt">SingleParticleView</span><span class="p">()</span><span class="o">.</span><span class="nf">tag</span><span class="p">(</span><span class="mi">0</span><span class="p">)</span>
            <span class="p">}</span>
        <span class="p">}</span>
    <span class="p">}</span>
<span class="p">}</span>
