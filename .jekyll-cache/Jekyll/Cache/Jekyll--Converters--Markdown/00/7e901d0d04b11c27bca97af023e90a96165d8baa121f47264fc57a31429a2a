    <span class="n">NSDictionary</span> <span class="o">*</span><span class="n">userInfo</span> <span class="o">=</span> <span class="n">noti</span><span class="p">.</span><span class="n">userInfo</span><span class="p">;</span>
    <span class="n">NSTimeInterval</span> <span class="n">animationDuration</span><span class="p">;</span>
