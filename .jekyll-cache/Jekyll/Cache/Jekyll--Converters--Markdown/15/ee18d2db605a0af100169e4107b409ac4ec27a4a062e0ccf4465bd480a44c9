    <span class="kt">char</span> <span class="o">*</span><span class="n">screenRecordingFileName</span> <span class="o">=</span> <span class="n">strdup</span><span class="p">([</span><span class="n">filePath</span> <span class="nf">fileSystemRepresentation</span><span class="p">]);</span>
