    <span class="kd">public</span> <span class="nf">init</span><span class="p">(</span><span class="nv">rawValue</span><span class="p">:</span> <span class="kt">UInt</span><span class="p">)</span>

    
    <span class="kd">public</span> <span class="kd">static</span> <span class="k">var</span> <span class="nv">layerMinXMinYCorner</span><span class="p">:</span> <span class="kt">CACornerMask</span> <span class="p">{</span> <span class="k">get</span> <span class="p">}</span>

    <span class="kd">public</span> <span class="kd">static</span> <span class="k">var</span> <span class="nv">layerMaxXMinYCorner</span><span class="p">:</span> <span class="kt">CACornerMask</span> <span class="p">{</span> <span class="k">get</span> <span class="p">}</span>

