    <span class="p">{</span>
        <span class="n">uptime</span> <span class="o">=</span> <span class="n">now</span><span class="p">.</span><span class="n">tv_sec</span> <span class="o">-</span> <span class="n">boottime</span><span class="p">.</span><span class="n">tv_sec</span><span class="p">;</span>
