<span class="c1">//核心代码 二次曲线方程式 可以google查一下</span>
<span class="p">[</span><span class="n">customPath</span> <span class="nf">addQuadCurveToPoint</span><span class="p">:</span><span class="n">endPoint</span> <span class="nf">controlPoint</span><span class="p">:</span><span class="n">controlPoint</span><span class="p">];</span>
