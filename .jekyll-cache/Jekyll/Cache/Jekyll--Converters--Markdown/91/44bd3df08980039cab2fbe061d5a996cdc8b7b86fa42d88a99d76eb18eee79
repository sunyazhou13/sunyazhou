<span class="n">pathAnimation</span><span class="p">.</span><span class="n">path</span> <span class="o">=</span> <span class="n">customPath</span><span class="p">.</span><span class="n">CGPath</span><span class="p">;</span> <span class="c1">//让动画沿着轨迹运动</span>

