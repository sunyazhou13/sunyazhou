        <span class="n">values</span><span class="p">[</span><span class="mi">1</span><span class="p">]</span> <span class="o">=</span> <span class="n">CFSwapInt16HostToBig</span><span class="p">([</span><span class="n">trackNumber</span> <span class="nf">unsignedIntValue</span><span class="p">]);</span>   <span class="c1">// 7</span>
