  <span class="nb">local </span><span class="nv">file_name</span><span class="o">=</span><span class="s2">"</span><span class="si">$(</span><span class="nb">basename</span> <span class="s2">"</span><span class="nv">$file_path</span><span class="s2">"</span><span class="si">)</span><span class="s2">"</span>
  <span class="nb">local </span><span class="nv">file_extension</span><span class="o">=</span><span class="s2">"</span><span class="k">${</span><span class="nv">file_name</span><span class="p">##*.</span><span class="k">}</span><span class="s2">"</span>
  <span class="nb">local </span><span class="nv">file_name_no_extension</span><span class="o">=</span><span class="s2">"</span><span class="k">${</span><span class="nv">file_name</span><span class="p">%.*</span><span class="k">}</span><span class="s2">"</span>
  
  <span class="k">if</span> <span class="o">[[</span> <span class="s2">"</span><span class="nv">$file_extension</span><span class="s2">"</span> <span class="o">==</span> <span class="s2">"HEIC"</span> <span class="o">||</span> <span class="s2">"</span><span class="nv">$file_extension</span><span class="s2">"</span> <span class="o">==</span> <span class="s2">"heic"</span> <span class="o">]]</span><span class="p">;</span> <span class="k">then
    </span><span class="nv">webp_file_path</span><span class="o">=</span><span class="s2">"</span><span class="nv">$downloads_dir</span><span class="s2">/</span><span class="nv">$file_name_no_extension</span><span class="s2">.avif"</span>
    cwebp <span class="nt">-q</span> 80 <span class="s2">"</span><span class="nv">$file_path</span><span class="s2">"</span> <span class="nt">-o</span> <span class="s2">"</span><span class="nv">$webp_file_path</span><span class="s2">"</span>
    <span class="nb">echo</span> <span class="s2">"转换完成: </span><span class="nv">$webp_file_path</span><span class="s2">"</span>
  <span class="k">fi</span>
<span class="o">}</span>

<span class="c"># Traverse the files in the Downloads directory</span>
find <span class="s2">"</span><span class="nv">$downloads_dir</span><span class="s2">"</span> <span class="nt">-type</span> f | <span class="k">while </span><span class="nb">read</span> <span class="nt">-r</span> file<span class="p">;</span> <span class="k">do
  </span>convert_heic_to_webp <span class="s2">"</span><span class="nv">$file</span><span class="s2">"</span>
<span class="k">done</span>

