    sips <span class="nt">-s</span> format png <span class="s2">"</span><span class="nv">$file_path</span><span class="s2">"</span> <span class="nt">--out</span> <span class="s2">"</span><span class="nv">$png_file_path</span><span class="s2">"</span>
    <span class="nb">echo</span> <span class="s2">"转换完成: </span><span class="nv">$png_file_path</span><span class="s2">"</span>
