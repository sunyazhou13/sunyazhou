<span class="nv">download_dir</span><span class="o">=</span><span class="s2">"</span><span class="nv">$HOME</span><span class="s2">/Downloads"</span>

<span class="c"># Convert HEIC files to PNG format</span>
convert_heic_to_png<span class="o">()</span> <span class="o">{</span>
  <span class="nb">local </span><span class="nv">file_path</span><span class="o">=</span><span class="s2">"</span><span class="nv">$1</span><span class="s2">"</span>
