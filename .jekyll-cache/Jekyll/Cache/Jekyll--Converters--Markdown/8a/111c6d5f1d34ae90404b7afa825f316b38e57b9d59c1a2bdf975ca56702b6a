  <span class="nb">local </span><span class="nv">file_extension</span><span class="o">=</span><span class="s2">"</span><span class="k">${</span><span class="nv">file_name</span><span class="p">##*.</span><span class="k">}</span><span class="s2">"</span>
  <span class="nb">local </span><span class="nv">file_name_no_extension</span><span class="o">=</span><span class="s2">"</span><span class="k">${</span><span class="nv">file_name</span><span class="p">%.*</span><span class="k">}</span><span class="s2">"</span>
  
