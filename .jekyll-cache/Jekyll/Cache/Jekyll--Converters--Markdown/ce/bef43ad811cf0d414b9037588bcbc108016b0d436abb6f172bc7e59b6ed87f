<span class="k">-</span> <span class="p">(</span><span class="n">NSString</span> <span class="o">*</span><span class="p">)</span><span class="nf">filterString1</span><span class="p">:(</span><span class="n">NSString</span> <span class="o">*</span><span class="p">)</span><span class="nv">str</span> <span class="p">{</span>
    <span class="n">NSString</span> <span class="o">*</span><span class="n">regex</span> <span class="o">=</span> <span class="s">@"^[a-zA-Z0-9\u4e00-\u9fa5]+"</span><span class="p">;</span>
