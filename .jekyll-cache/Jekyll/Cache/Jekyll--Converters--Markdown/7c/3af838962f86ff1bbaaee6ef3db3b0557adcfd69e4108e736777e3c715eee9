<span class="k">let</span> <span class="nv">c</span> <span class="o">=</span> <span class="nf">zip</span><span class="p">(</span><span class="mi">1</span><span class="o">...</span><span class="p">,</span> <span class="n">b</span><span class="p">)</span><span class="o">.</span><span class="n">map</span> <span class="p">{</span> <span class="nv">$0</span> <span class="p">}</span>
<span class="nf">print</span><span class="p">(</span><span class="n">c</span><span class="p">)</span>
