    </tr>
  </thead>
  <tbody>
    <tr>
      <td>Ctrl + C</td>
      <td>Terminate the current process</td>
    </tr>
    <tr>
      <td>Ctrl + Z</td>
      <td>Suspend the current process in the background</td>
    </tr>
    <tr>
