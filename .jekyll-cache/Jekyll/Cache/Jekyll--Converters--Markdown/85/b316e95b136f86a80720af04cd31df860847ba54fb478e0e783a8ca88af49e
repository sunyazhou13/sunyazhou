    </tr>
    <tr>
      <td><code class="language-plaintext highlighter-rouge">--now</code></td>
      <td>rename only: set the date to now</td>
      <td>rename</td>
    </tr>
    <tr>
      <td><code class="language-plaintext highlighter-rouge">-c, --collection NAME</code></td>
      <td>Create in a custom collection, e.g. <code class="language-plaintext highlighter-rouge">-c wiki</code> → <code class="language-plaintext highlighter-rouge">_wiki/</code></td>
