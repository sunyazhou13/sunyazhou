11
</pre></td> --><td class="rouge-code"><pre><span class="na">jekyll_compose</span><span class="pi">:</span>
  <span class="na">default_front_matter</span><span class="pi">:</span>
    <span class="na">posts</span><span class="pi">:</span>          <span class="c1"># post 命令用</span>
      <span class="na">categories</span><span class="pi">:</span> <span class="pi">[</span><span class="nv">iOS</span><span class="pi">]</span>
      <span class="na">tags</span><span class="pi">:</span> <span class="pi">[]</span>
      <span class="na">typora-root-url</span><span class="pi">:</span> <span class="s">..</span>
      <span class="na">math</span><span class="pi">:</span> <span class="kc">true</span>
