        <span class="n">NSBundle</span> <span class="o">*</span><span class="n">mainBundle</span> <span class="o">=</span> <span class="p">[</span><span class="n">NSBundle</span> <span class="nf">mainBundle</span><span class="p">];</span>
        <span class="n">NSString</span> <span class="o">*</span><span class="n">resourcePath</span> <span class="o">=</span> <span class="p">[</span><span class="n">mainBundle</span> <span class="nf">pathForResource</span><span class="p">:</span><span class="n">kYZToolsAssets</span> <span class="nf">ofType</span><span class="p">:</span><span class="s">@"bundle"</span><span class="p">];</span>
