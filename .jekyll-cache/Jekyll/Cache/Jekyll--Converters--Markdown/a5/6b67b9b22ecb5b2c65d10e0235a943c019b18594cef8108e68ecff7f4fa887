                <span class="n">DLinkedNode</span> <span class="o">*</span><span class="n">node</span> <span class="o">=</span> <span class="n">removeTail</span><span class="p">();</span>
                <span class="n">cache</span><span class="p">.</span><span class="n">erase</span><span class="p">(</span><span class="n">node</span><span class="o">-&gt;</span><span class="n">key</span><span class="p">);</span>
                <span class="k">delete</span> <span class="n">node</span><span class="p">;</span>
