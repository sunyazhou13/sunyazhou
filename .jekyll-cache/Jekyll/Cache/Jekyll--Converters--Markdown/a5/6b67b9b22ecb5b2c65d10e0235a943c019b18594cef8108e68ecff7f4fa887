        <span class="n">tail</span><span class="o">-&gt;</span><span class="n">prev</span> <span class="o">=</span> <span class="n">head</span><span class="p">;</span> <span class="c1">//前驱连接头部</span>
    <span class="p">}</span>
    
    <span class="kt">void</span> <span class="nf">addToHead</span><span class="p">(</span><span class="n">DLinkedNode</span><span class="o">*</span> <span class="n">node</span><span class="p">)</span> <span class="p">{</span>
        <span class="n">node</span><span class="o">-&gt;</span><span class="n">prev</span> <span class="o">=</span> <span class="n">head</span><span class="p">;</span>
