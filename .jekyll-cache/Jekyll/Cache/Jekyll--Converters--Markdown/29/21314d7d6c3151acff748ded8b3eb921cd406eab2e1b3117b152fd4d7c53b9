#pragma mark - event response, all triggered event responses: buttons, notifications, segmented controls, etc.
</span><span class="k">-</span> <span class="p">(</span><span class="kt">void</span><span class="p">)</span><span class="n">statusBarTouchBegin</span> <span class="p">{</span>
    <span class="n">_currentIndex</span> <span class="o">=</span> <span class="mi">0</span><span class="p">;</span> <span class="c1">//KVO</span>
<span class="p">}</span>

</pre></td></tr></tbody></table></code></pre></div></div>

