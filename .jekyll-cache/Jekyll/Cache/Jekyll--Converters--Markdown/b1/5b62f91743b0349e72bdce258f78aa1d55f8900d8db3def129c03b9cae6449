</pre></td> --><td class="rouge-code"><pre><span class="k">+</span> <span class="p">(</span><span class="n">UIImage</span><span class="o">*</span><span class="p">)</span><span class="nf">uiImageFromPixelBuffer</span><span class="p">:(</span><span class="n">CVPixelBufferRef</span><span class="p">)</span><span class="nv">p</span> <span class="p">{</span>
