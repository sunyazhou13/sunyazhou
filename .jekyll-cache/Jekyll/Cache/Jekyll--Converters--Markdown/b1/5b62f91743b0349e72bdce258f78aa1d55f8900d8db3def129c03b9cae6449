</pre></td> --><td class="rouge-code"><pre><span class="n">CVOpenGLESTextureCacheCreate</span><span class="p">(</span><span class="n">kCFAllocatorDefault</span><span class="p">,</span> <span class="nb">NULL</span><span class="p">,</span> <span class="n">_context</span><span class="p">,</span> <span class="nb">NULL</span><span class="p">,</span> <span class="o">&amp;</span><span class="n">_textureCache</span><span class="p">);</span>
