</pre></td><td class="rouge-code"><pre><span class="kr">inline</span> <span class="nf">xx_smoothstep</span><span class="p">(</span><span class="n">T</span> <span class="n">minEdge</span><span class="p">,</span> <span class="n">T</span> <span class="n">maxEdge</span><span class="p">,</span> <span class="n">value</span><span class="p">)</span> <span class="p">{</span>
