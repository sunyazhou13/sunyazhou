</pre></td><td class="rouge-code"><pre><span class="k">+</span> <span class="p">(</span><span class="kt">void</span><span class="p">)</span><span class="nf">setEnabled</span><span class="p">:(</span><span class="n">BOOL</span><span class="p">)</span><span class="nv">enable</span> <span class="nf">forSessionConfiguration</span><span class="p">:(</span><span class="n">NSURLSessionConfiguration</span><span class="o">*</span><span class="p">)</span><span class="nv">sessionConfig</span>
<span class="p">{</span>
