        <span class="o">&amp;&amp;</span> <span class="p">[</span><span class="n">sessionConfig</span> <span class="nf">respondsToSelector</span><span class="p">:</span><span class="k">@selector</span><span class="p">(</span><span class="nf">setProtocolClasses</span><span class="p">:)])</span>
