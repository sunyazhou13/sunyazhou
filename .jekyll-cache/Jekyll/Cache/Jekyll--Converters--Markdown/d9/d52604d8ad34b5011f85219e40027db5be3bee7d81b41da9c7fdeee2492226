<span class="n">NSScanner</span> <span class="o">*</span><span class="n">scanner</span> <span class="o">=</span> <span class="p">[</span><span class="n">NSScanner</span> <span class="nf">scannerWithString</span><span class="p">:</span><span class="n">str1</span><span class="p">];</span>
