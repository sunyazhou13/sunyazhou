                                <span class="p">[</span><span class="n">fromVC</span> <span class="nf">removeFromParentViewController</span><span class="p">];</span>

                                <span class="n">self</span><span class="p">.</span><span class="n">currentVC</span> <span class="o">=</span> <span class="n">toVC</span><span class="p">;</span>
                            <span class="p">}];</span>
