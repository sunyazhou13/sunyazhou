<span class="k">self</span><span class="o">.</span><span class="n">backgroundView</span><span class="o">.</span><span class="n">layer</span><span class="o">.</span><span class="n">maskedCorners</span> <span class="o">=</span> <span class="p">[</span><span class="o">.</span><span class="n">layerMinXMinYCorner</span><span class="p">,</span><span class="o">.</span><span class="n">layerMinXMaxYCorner</span><span class="p">,</span><span class="o">.</span><span class="n">layerMaxXMinYCorner</span><span class="p">,</span><span class="o">.</span><span class="n">layerMaxXMaxYCorner</span><span class="p">];</span> <span class="c1">//设置圆角方向</span>
