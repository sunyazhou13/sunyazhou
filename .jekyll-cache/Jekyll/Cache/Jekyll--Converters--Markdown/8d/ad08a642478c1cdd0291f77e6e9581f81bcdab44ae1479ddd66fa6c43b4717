SYZ_TEST <span class="o">=</span> @<span class="s2">"https://xxxxx.com/"</span>
<span class="c">#include "../Pods/Target Support Files/Pods-XcodeConfigDemo/Pods-XcodeConfigDemo.release.xcconfig"</span>
<span class="c">#include "DemoCommon.xcconfig"</span>

//release
SUNYAZHOU_COM <span class="o">=</span> @<span class="s2">"https://www.sunyazhou.com/"</span>
