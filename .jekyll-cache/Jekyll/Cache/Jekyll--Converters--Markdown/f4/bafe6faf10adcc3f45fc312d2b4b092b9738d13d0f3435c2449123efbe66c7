8
</pre></td><td class="rouge-code"><pre>	<span class="n">NSLog</span><span class="p">(</span><span class="s">@"Current Category:%@"</span><span class="p">,</span> <span class="p">[</span><span class="n">AVAudioSession</span> <span class="nf">sharedInstance</span><span class="p">].</span><span class="n">category</span><span class="p">);</span>
