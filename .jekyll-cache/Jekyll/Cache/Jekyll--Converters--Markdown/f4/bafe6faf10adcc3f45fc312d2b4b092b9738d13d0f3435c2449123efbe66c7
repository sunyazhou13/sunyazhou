</pre></td><td class="rouge-code"><pre><span class="k">-</span> <span class="p">(</span><span class="kt">void</span><span class="p">)</span><span class="n">configSession</span><span class="p">{</span>	
    <span class="p">[[</span><span class="n">AVAudioSession</span> <span class="nf">sharedInstance</span><span class="p">]</span> <span class="nf">setCategory</span><span class="p">:</span><span class="n">AVAudioSessionCategorySoloAmbient</span> <span class="nf">error</span><span class="p">:</span><span class="o">&amp;</span><span class="n">error</span><span class="p">];</span>
