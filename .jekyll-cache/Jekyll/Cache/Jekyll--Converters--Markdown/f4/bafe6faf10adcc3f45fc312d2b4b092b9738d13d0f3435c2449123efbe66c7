<span class="n">AVF_EXPORT</span> <span class="n">NSString</span> <span class="o">*</span><span class="k">const</span> <span class="n">AVAudioSessionCategorySoloAmbient</span><span class="p">;</span>

<span class="n">AVF_EXPORT</span> <span class="n">NSString</span> <span class="o">*</span><span class="k">const</span> <span class="n">AVAudioSessionCategoryPlayback</span><span class="p">;</span>

