<span class="n">UIBezierPath</span> <span class="o">*</span><span class="n">customPath</span> <span class="o">=</span> <span class="p">[</span><span class="n">UIBezierPath</span> <span class="nf">bezierPath</span><span class="p">];</span> <span class="c1">//创建贝塞尔轨迹</span>
