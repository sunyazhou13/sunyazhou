    <span class="kt">double</span> <span class="n">deltaX</span> <span class="o">=</span> <span class="n">fabs</span><span class="p">(</span><span class="n">filteredAcceleration</span><span class="p">.</span><span class="n">x</span> <span class="o">-</span> <span class="n">self</span><span class="p">.</span><span class="n">previousAcceleration</span><span class="p">.</span><span class="n">x</span><span class="p">);</span>
