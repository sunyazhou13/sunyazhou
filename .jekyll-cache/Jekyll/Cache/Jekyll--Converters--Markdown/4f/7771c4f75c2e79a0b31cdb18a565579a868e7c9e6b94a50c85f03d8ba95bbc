    <span class="k">if</span> <span class="p">(</span><span class="n">deltaX</span> <span class="o">&gt;</span> <span class="n">threshold</span> <span class="o">||</span> <span class="n">deltaY</span> <span class="o">&gt;</span> <span class="n">threshold</span> <span class="o">||</span> <span class="n">deltaZ</span> <span class="o">&gt;</span> <span class="n">threshold</span><span class="p">)</span> <span class="p">{</span>
