<span class="k">static</span> <span class="kt">void</span> <span class="nf">cleanupAfterMain</span><span class="p">(</span><span class="kt">void</span><span class="p">)</span> <span class="p">{</span>
    <span class="n">printf</span><span class="p">(</span><span class="s">"5. main() 返回后自动调用</span><span class="se">\n</span><span class="s">"</span><span class="p">);</span>
<span class="p">}</span>

