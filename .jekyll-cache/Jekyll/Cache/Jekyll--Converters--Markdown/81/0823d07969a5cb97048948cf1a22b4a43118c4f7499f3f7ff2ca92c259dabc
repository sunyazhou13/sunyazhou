<span class="k">-</span> <span class="p">(</span><span class="n">id</span><span class="p">)</span><span class="n">borrowedObject</span> <span class="nf">__attribute__</span><span class="p">((</span><span class="n">ns_returns_not_retained</span><span class="p">));</span>
<span class="c1">// 告诉 ARC 返回的是非持有引用</span>

<span class="c1">// 对应宏：NS_RETURNS_RETAINED、NS_RETURNS_NOT_RETAINED</span>
<span class="c1">// 以及 CF_RETURNS_RETAINED、CF_RETURNS_NOT_RETAINED（CF 版本）</span>
</pre></td></tr></tbody></table></code></pre></div></div>

