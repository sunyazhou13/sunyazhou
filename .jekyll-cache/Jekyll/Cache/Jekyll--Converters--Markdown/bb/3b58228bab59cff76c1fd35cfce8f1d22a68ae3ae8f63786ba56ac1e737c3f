5
</pre></td> --><td class="rouge-code"><pre><span class="k">@interface</span> <span class="nc">ViewController</span> <span class="p">:</span> <span class="nc">UIViewController</span>
<span class="k">-</span> <span class="p">(</span><span class="kt">void</span><span class="p">)</span><span class="n">xxxMethodA</span> <span class="nf">API_AVAILABLE</span><span class="p">(</span><span class="n">ios</span><span class="p">(</span><span class="mi">11</span><span class="p">.</span><span class="mi">0</span><span class="p">));</span>
<span class="k">-</span> <span class="p">(</span><span class="kt">void</span><span class="p">)</span><span class="n">xxxMethodB</span> <span class="nf">API_AVAILABLE</span><span class="p">(</span><span class="n">ios</span><span class="p">(</span><span class="mi">8</span><span class="p">.</span><span class="mi">0</span><span class="p">),</span> <span class="n">macos</span><span class="p">(</span><span class="mi">10</span><span class="p">.</span><span class="mi">10</span><span class="p">),</span> <span class="n">watchos</span><span class="p">(</span><span class="mi">2</span><span class="p">.</span><span class="mi">0</span><span class="p">),</span> <span class="n">tvos</span><span class="p">(</span><span class="mi">9</span><span class="p">.</span><span class="mi">0</span><span class="p">));</span>
<span class="k">@end</span>

</pre></td></tr></tbody></table></code></pre></div></div>

<blockquote>
  <p>Remember that <code class="language-plaintext highlighter-rouge">macos</code>, <code class="language-plaintext highlighter-rouge">ios</code>, <code class="language-plaintext highlighter-rouge">watchos</code>, <code class="language-plaintext highlighter-rouge">tvos</code> must all be lowercase</p>
</blockquote>

<p>By using this approach for availability checks, the editor won’t produce warnings, and at runtime the corresponding code is executed based on the iOS system version.</p>

