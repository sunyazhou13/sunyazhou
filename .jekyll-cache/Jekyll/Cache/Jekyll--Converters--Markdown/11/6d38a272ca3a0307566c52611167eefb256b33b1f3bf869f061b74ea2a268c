4
</pre></td><td class="rouge-code"><pre><span class="c">#添加以下内容,注意顺序不能调换</span>
<span class="nv">IPTABLES_MODULES</span><span class="o">=</span><span class="s2">"ip_conntrack_ftp"</span>
