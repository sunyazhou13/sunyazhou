    <span class="n">BOOL</span> <span class="n">clickSameCell</span> <span class="o">=</span> <span class="p">(</span><span class="n">self</span><span class="p">.</span><span class="n">lastSelectedIndexPath</span> <span class="o">==</span> <span class="n">indexPath</span><span class="p">);</span>
    <span class="k">if</span> <span class="p">(</span><span class="n">clickSameCell</span><span class="p">)</span> <span class="p">{</span>
        <span class="c1">//选择同一个cell</span>
        <span class="n">selectedModel</span><span class="p">.</span><span class="n">isSelected</span> <span class="o">=</span> <span class="o">!</span><span class="n">selectedModel</span><span class="p">.</span><span class="n">isSelected</span><span class="p">;</span>
    <span class="p">}</span> <span class="k">else</span> <span class="p">{</span>
        <span class="n">lastModel</span><span class="p">.</span><span class="n">isSelected</span> <span class="o">=</span> <span class="nb">NO</span><span class="p">;</span>
        <span class="n">selectedModel</span><span class="p">.</span><span class="n">isSelected</span> <span class="o">=</span> <span class="nb">YES</span><span class="p">;</span>   
    <span class="p">}</span>
    <span class="n">selectedModel</span><span class="p">.</span><span class="n">modelStatus</span> <span class="o">=</span> <span class="n">KSYMultiCanvasModelStatusRecording</span><span class="p">;</span> <span class="c1">//这就会出发 cell的 KVO 了</span>
<span class="p">}</span>

</pre></td></tr></tbody></table></code></pre></div></div>

