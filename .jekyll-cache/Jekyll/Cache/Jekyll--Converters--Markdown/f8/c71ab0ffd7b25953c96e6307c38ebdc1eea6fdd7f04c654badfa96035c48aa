    <span class="p">[</span><span class="n">self</span><span class="p">.</span><span class="n">canvasCollectionView</span><span class="p">.</span><span class="n">visibleCells</span> <span class="nf">enumerateObjectsUsingBlock</span><span class="p">:</span><span class="o">^</span><span class="p">(</span><span class="n">KSYCanvasCell</span> <span class="o">*</span><span class="n">cell</span><span class="p">,</span> <span class="n">NSUInteger</span> <span class="n">idx</span><span class="p">,</span> <span class="n">BOOL</span> <span class="o">*</span> <span class="n">_Nonnull</span> <span class="n">stop</span><span class="p">)</span> <span class="p">{</span>
        <span class="p">[</span><span class="n">cell</span> <span class="nf">removeObserver</span><span class="p">:</span><span class="n">cell</span>
                  <span class="nl">forKeyPath:</span><span class="n">KSYKeyPathForModelStatus</span>
                     <span class="nl">context:</span><span class="o">&amp;</span><span class="n">KSYModelKVOStatusContext</span><span class="p">];</span>
    <span class="p">}];</span>
