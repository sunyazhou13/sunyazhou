    <span class="k">if</span> <span class="p">(</span><span class="n">trackNumber</span> <span class="o">&amp;&amp;</span> <span class="o">!</span><span class="p">[</span><span class="n">trackNumber</span> <span class="nf">isKindOfClass</span><span class="p">:[</span><span class="n">NSNull</span> <span class="nf">class</span><span class="p">]])</span> <span class="p">{</span>
