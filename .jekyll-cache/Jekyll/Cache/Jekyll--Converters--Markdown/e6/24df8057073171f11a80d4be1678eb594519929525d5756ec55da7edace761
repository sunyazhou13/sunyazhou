<span class="c1">/// Use maximum width Shortcut:[push(to:.center)](x-source-tag://push)</span>
<span class="kd">func</span> <span class="nf">maxWidth</span><span class="p">()</span> <span class="o">-&gt;</span> <span class="kd">some</span> <span class="kt">View</span> <span class="p">{</span>
