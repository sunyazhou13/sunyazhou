    <span class="k">case</span> <span class="o">.</span><span class="nv">center</span><span class="p">:</span>
        <span class="k">return</span> <span class="nf">frame</span><span class="p">(</span><span class="nv">maxWidth</span><span class="p">:</span> <span class="o">.</span><span class="n">infinity</span><span class="p">,</span> <span class="nv">alignment</span><span class="p">:</span>  <span class="o">.</span><span class="n">center</span><span class="p">)</span>
    <span class="k">case</span> <span class="o">.</span><span class="nv">trailing</span><span class="p">:</span>
