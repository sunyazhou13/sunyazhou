<span class="k">typedef</span> <span class="nf">void</span> <span class="p">(</span><span class="o">^</span><span class="n">cleanup_block_t</span><span class="p">)(</span><span class="kt">void</span><span class="p">);</span>

<span class="k">static</span> <span class="kr">inline</span> <span class="kt">void</span> <span class="nf">defer_block_cleanup</span><span class="p">(</span><span class="n">cleanup_block_t</span> <span class="o">*</span><span class="n">block</span><span class="p">)</span> <span class="p">{</span>
