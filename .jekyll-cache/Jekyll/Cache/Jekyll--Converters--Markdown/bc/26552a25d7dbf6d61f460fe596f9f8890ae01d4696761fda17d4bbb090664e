    <span class="k">if</span> <span class="p">(</span><span class="n">someError</span><span class="p">)</span> <span class="k">return</span><span class="p">;</span> <span class="c1">// 也会触发 defer</span>
    <span class="c1">// ...</span>
<span class="p">}</span>
</pre></td></tr></tbody></table></code></pre></div></div>

