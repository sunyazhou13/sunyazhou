<span class="k">-</span> <span class="p">(</span><span class="n">instancetype</span><span class="p">)</span><span class="n">init</span> <span class="p">{</span>
    <span class="c1">// If you don't call [self initWithFrame:], the compiler warns:</span>
    <span class="c1">// ⚠️ Convenience initializer missing a 'self' call to another initializer</span>
    <span class="k">return</span> <span class="p">[</span><span class="n">self</span> <span class="nf">initWithFrame</span><span class="p">:</span><span class="n">CGRectZero</span><span class="p">];</span>
<span class="p">}</span>

<span class="k">@end</span>
</pre></td></tr></tbody></table></code></pre></div></div>

<p>Rules:</p>
<ul>
  <li>Convenience initializers <strong>must</strong> call one of the class’s designated initializers</li>
  <li>Subclasses must override <strong>all</strong> of the superclass’s designated initializers (or disable them with <code class="language-plaintext highlighter-rouge">NS_UNAVAILABLE</code>)</li>
  <li>The <code class="language-plaintext highlighter-rouge">NS_DESIGNATED_INITIALIZER</code> macro is just a wrapper for this attribute</li>
</ul>

