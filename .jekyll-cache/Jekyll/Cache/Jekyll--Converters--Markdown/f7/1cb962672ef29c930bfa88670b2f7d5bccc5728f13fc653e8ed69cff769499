    <span class="k">if</span> <span class="n">metadataObj</span><span class="o">.</span><span class="n">type</span> <span class="o">==</span> <span class="kt">AVMetadataObjectTypeQRCode</span> <span class="p">{</span>
        <span class="c1">// If the found metadata is equal to the QR code metadata then update the status label's text and set the bounds</span>
        <span class="k">let</span> <span class="nv">barCodeObject</span> <span class="o">=</span> <span class="n">videoPreviewLayer</span><span class="p">?</span><span class="o">.</span><span class="nf">transformedMetadataObject</span><span class="p">(</span><span class="nv">for</span><span class="p">:</span> <span class="n">metadataObj</span><span class="p">)</span>
