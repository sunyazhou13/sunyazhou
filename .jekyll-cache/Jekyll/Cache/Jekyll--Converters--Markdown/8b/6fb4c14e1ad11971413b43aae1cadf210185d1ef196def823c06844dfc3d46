</pre></td><td class="rouge-code"><pre><span class="kt">ScrollView</span> <span class="p">{</span>
            <span class="kt">VStack</span><span class="p">(</span><span class="nv">spacing</span><span class="p">:</span> <span class="mi">30</span><span class="p">)</span> <span class="p">{</span>
                <span class="n">foodImage</span>
                <span class="kt">Text</span><span class="p">(</span><span class="s">"今天吃什么?"</span><span class="p">)</span><span class="o">.</span><span class="nf">bold</span><span class="p">()</span>
                <span class="n">selectedFoodInfoView</span>
